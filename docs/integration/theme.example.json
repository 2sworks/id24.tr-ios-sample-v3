      "secondary": { "borderWidth": 1, "borderColor": "#334155" }
    }
  },
  "selection": { "cornerRadius": 10, "checkboxCornerRadius": 4, "rowMinHeight": 52 },
  "alerts":    { "cornerRadius": 20, "maxWidth": 340, "scrimOpacity": 0.5 },
  "banners":   { "cornerRadius": 14 },
  "fields":    { "cornerRadius": 10, "borderWidth": 1 },
  "sheets":    { "cornerRadius": 28 },
  "capture":   { "maskOpacity": 0.5 },
  "controls":  { "shutterSize": 76 },
  "call":      { "panelCornerRadius": 28 },
  "motion":    { "transitionDuration": 0.28, "overlayDuration": 0.2 },
  "icons":     { "headerLogo": "my_mark" }

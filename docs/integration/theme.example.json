{
  "_comment": "IdentifySDK tema örneği — SDKTheme.shared.applyTheme(named:) / setTheme() ile uygulanır.",
  "colors": {
    "primary": "#0F172A",
    "success": "#22C55E",
    "error": "#EF4444",
    "accentWarning": "#F59E0B",
    "pageBackground":   { "light": "#F8FAFC", "dark": "#0B1120" },
    "moduleBackground": { "light": "#0F172A", "dark": "#0B1120" },
    "surface":          { "light": "#F1F5F9", "dark": "#111827" },
    "title":            { "light": "#0F172A", "dark": "#FFFFFF" },
    "subtitle":         { "light": "#64748B", "dark": "#94A3B8" },
    "border":           { "light": "#E2E8F0", "dark": "#1F2937" },
    "headerBackground": { "light": "#0F172A", "dark": "#0B1120" },
    "headerTitle": "#FFFFFF",
    "headerSubtitle": "#CBD5E1",
    "headerIcon": "#FFFFFF",
    "headerIconBackground": "#1E293B",
    "headerIconBorder": "#334155",
    "progressActive": "#38BDF8",
    "progressInactive": "#334155",
    "selectedItemBackground": "#1D4ED8",
